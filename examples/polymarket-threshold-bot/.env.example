# --- REQUIRED for trading (LIVE) ---
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS
POLY_SIGNATURE_TYPE=0

# Optional: provide existing L2 creds instead of creating/deriving at runtime
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# --- Bot config ---
POLY_TOKEN_ID=YOUR_CLOB_TOKEN_ID
BOT_DRY_RUN=true
BOT_POLL_INTERVAL_SECONDS=2.0

# Thresholds
STRAT_BUY_THRESHOLD=0.45
STRAT_SELL_THRESHOLD=0.55

# Sizing (market order semantics: BUY amount=USD, SELL amount=shares)
STRAT_BUY_AMOUNT_USD=10.00
STRAT_SELL_SHARES=5.00
STRAT_ORDER_TYPE=FAK  # FOK or FAK (market order types)

# Risk
RISK_MAX_POSITION_SHARES=50
RISK_MAX_USD_SPEND=200
RISK_MIN_SECONDS_BETWEEN_ORDERS=5
RISK_MAX_OPEN_ORDERS=10

# Storage/logging
BOT_SQLITE_PATH=bot.sqlite3
BOT_LOG_JSON=false
BOT_LOG_LEVEL=INFO

# Kill switch
BOT_KILL_SWITCH_PATH=./KILL_SWITCH

# Heartbeat (needed if you keep resting orders; safe to keep off for FOK/FAK-only strategies)
BOT_HEARTBEAT_ENABLED=false
BOT_HEARTBEAT_INTERVAL_SECONDS=5.0
