# Polymarket Platform -- Environment Configuration
# -----------------------------------------------------------------------
# Copy this file to .env and fill in the values you need.
#
# SINGLE-TOKEN MODE  (polymarket run):
#   Required: POLY_TOKEN_ID
#   For live:  POLY_TOKEN_ID + POLY_PRIVATE_KEY + POLY_FUNDER_ADDRESS
#
# SCANNER MODE  (polymarket scan):
#   Required: SCANNER_ENABLED=true
#   Optional: POLY_TOKEN_ID is NOT needed -- scanner discovers tokens
#   For live:  POLY_PRIVATE_KEY + POLY_FUNDER_ADDRESS
# -----------------------------------------------------------------------


# === CORE MARKET =========================================================
# The CLOB token ID for the market to trade.
# Required for single-token mode (polymarket run).
# Not required for scanner mode (polymarket scan).
POLY_TOKEN_ID=YOUR_CLOB_TOKEN_ID


# === BOT MODE ============================================================
# true  = paper trading (no real orders, no credentials needed)
# false = live trading (requires POLY_PRIVATE_KEY + POLY_FUNDER_ADDRESS)
BOT_DRY_RUN=true

BOT_SQLITE_PATH=platform.sqlite3   # SQLite database file
BOT_LOG_JSON=false                  # true = JSON lines; false = human-readable
BOT_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
BOT_KILL_SWITCH_PATH=./KILL_SWITCH  # Create this file to stop the bot immediately


# === LIVE TRADING CREDENTIALS ============================================
# Required only when BOT_DRY_RUN=false. NEVER commit these values.
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS
POLY_SIGNATURE_TYPE=0

# Optional: pre-derived L2 API credentials (skips on-start derivation).
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=


# === STRATEGY THRESHOLDS =================================================
# Default ThresholdStrategy (used in both single-token and scanner modes).
BUY_THRESHOLD=0.45          # Buy when ask <= this
SELL_THRESHOLD=0.55         # Sell when bid >= this (and position held)
STRAT_BUY_AMOUNT_USD=10.00  # USD per BUY order
STRAT_SELL_SHARES=5.00      # Shares per SELL order
STRAT_ORDER_TYPE=FAK        # FAK (Fill-And-Kill) | FOK (Fill-Or-Kill)


# === PROFITABILITY GATE ==================================================
FEE_TAKER_BPS=200           # Polymarket taker fee in basis points
MIN_EXPECTED_EDGE_BPS=50    # Minimum net edge required after fees


# === RISK LIMITS =========================================================
RISK_MAX_POSITION_SHARES=50           # Max shares held per token
RISK_MAX_USD_SPEND=200                # Cumulative USD cap (persisted)
RISK_MIN_SECONDS_BETWEEN_ORDERS=5     # Cooldown between orders (s)
RISK_MAX_OPEN_ORDERS=10               # Max concurrent open orders (live)


# === CIRCUIT BREAKER =====================================================
CB_MAX_CONSECUTIVE_LOSSES=5
CB_MAX_DAILY_DRAWDOWN_USD=50.0
CB_MAX_DECISION_LATENCY_MS=500.0


# === FEED SETTINGS =======================================================
FEED_FALLBACK_AFTER_FAILURES=5
FEED_POLL_INTERVAL_SECONDS=2.0
FEED_MAX_STALENESS_SECONDS=30.0
FEED_WS_MAX_RECONNECT_BACKOFF=60.0


# === MISC ================================================================
BOT_POSITION_REFRESH_INTERVAL_SECONDS=10.0
BOT_HEARTBEAT_ENABLED=false
BOT_HEARTBEAT_INTERVAL_SECONDS=15.0
BOT_MAX_RETRIES=4
BOT_REQUEST_TIMEOUT_SECONDS=15.0


# =========================================================================
# SCANNER / LAYER 2 SETTINGS
# =========================================================================
# Enable scanner mode: discovers markets autonomously, no POLY_TOKEN_ID needed.
SCANNER_ENABLED=false

# How often to poll Gamma for new markets (seconds).
SCANNER_POLL_INTERVAL_SECONDS=120

# --- Market filters (hard limits; failing any excludes the market) --------
MIN_LIQUIDITY_USD=1000         # Minimum on-chain liquidity
MIN_VOLUME_24H_USD=200         # Minimum 24h traded volume
MAX_SPREAD_BPS=800             # Maximum spread (in basis points) accepted
MIN_DAYS_TO_EXPIRY=1.0         # Minimum remaining market lifetime (days)

# --- Worker pool limits ---------------------------------------------------
MAX_CONCURRENT_MARKETS=3       # Maximum number of markets actively traded at once
MAX_TOTAL_CAPITAL_USD=100      # Total capital budget across all active workers
MAX_CAPITAL_PER_MARKET_USD=30  # Per-market capital cap (overrides RISK_MAX_USD_SPEND)

# --- Opportunity thresholds -----------------------------------------------
# Opportunities below either threshold are discarded before launching workers.
OPPORTUNITY_MIN_CONFIDENCE=0.20   # 0.0-1.0 (higher = stricter)
OPPORTUNITY_MIN_EDGE_BPS=50       # Minimum expected edge in basis points

# --- Historical lookback for signal detection ----------------------------
MARKET_HISTORY_LOOKBACK_MINUTES=60

# --- How many markets to pull from Gamma per scan cycle ------------------
MARKET_DISCOVERY_LIMIT=100

# --- How often the orchestrator rebalances the worker pool (0 = every cycle)
ORCHESTRATOR_REBALANCE_SECONDS=0
