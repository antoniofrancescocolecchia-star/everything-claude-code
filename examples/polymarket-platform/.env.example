# ─── Market ───────────────────────────────────────────────────────────────────
# Required: CLOB token id for the outcome you want to trade
POLY_TOKEN_ID=YOUR_CLOB_TOKEN_ID

# ─── Mode ─────────────────────────────────────────────────────────────────────
BOT_DRY_RUN=true           # true → paper trade; no credentials needed
BOT_SQLITE_PATH=platform.sqlite3
BOT_LOG_JSON=false
BOT_LOG_LEVEL=INFO
BOT_KILL_SWITCH_PATH=./KILL_SWITCH

# ─── Live credentials (required only when BOT_DRY_RUN=false) ─────────────────
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS
POLY_SIGNATURE_TYPE=0

# Optional: pre-derived L2 API creds (avoids on-start key derivation)
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=

# ─── Strategy: threshold (default plugin) ─────────────────────────────────────
BUY_THRESHOLD=0.45          # buy when ask <= this (= our estimated fair value)
SELL_THRESHOLD=0.55         # sell when bid >= this
STRAT_BUY_AMOUNT_USD=10.00
STRAT_SELL_SHARES=5.00
STRAT_ORDER_TYPE=FAK        # FAK (Fill-And-Kill) | FOK (Fill-Or-Kill)

# ─── Profitability gate ────────────────────────────────────────────────────────
FEE_TAKER_BPS=200           # Polymarket taker fee estimate (bps). Verify per-market.
MIN_EXPECTED_EDGE_BPS=50    # Minimum net edge (after fees) required to trade

# ─── Risk ─────────────────────────────────────────────────────────────────────
RISK_MAX_POSITION_SHARES=50
RISK_MAX_USD_SPEND=200      # Cumulative USD cap (persisted across restarts)
RISK_MIN_SECONDS_BETWEEN_ORDERS=5
RISK_MAX_OPEN_ORDERS=10

# ─── Circuit breaker ──────────────────────────────────────────────────────────
CB_MAX_CONSECUTIVE_LOSSES=5
CB_MAX_DAILY_DRAWDOWN_USD=50.0
CB_MAX_DECISION_LATENCY_MS=500.0

# ─── Feed ─────────────────────────────────────────────────────────────────────
FEED_FALLBACK_AFTER_FAILURES=5   # WS failures before switching to REST poll
FEED_POLL_INTERVAL_SECONDS=2.0   # REST fallback interval
FEED_MAX_STALENESS_SECONDS=30.0  # Trip CB if no quote for this long
FEED_WS_MAX_RECONNECT_BACKOFF=60.0

# ─── Position refresh ─────────────────────────────────────────────────────────
BOT_POSITION_REFRESH_INTERVAL_SECONDS=10.0

# ─── Heartbeat (for resting/GTC orders only) ──────────────────────────────────
BOT_HEARTBEAT_ENABLED=false
BOT_HEARTBEAT_INTERVAL_SECONDS=15.0

# ─── Retry / timeouts ─────────────────────────────────────────────────────────
BOT_MAX_RETRIES=4
BOT_REQUEST_TIMEOUT_SECONDS=15.0
