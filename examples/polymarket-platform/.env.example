# Polymarket Platform — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in the values you need.
# Mandatory for dry-run : POLY_TOKEN_ID
# Mandatory for live mode: POLY_TOKEN_ID + POLY_PRIVATE_KEY + POLY_FUNDER_ADDRESS


# ═══ CORE MARKET ═════════════════════════════════════════════════════════════
# The CLOB token ID for the market you want to trade.
# Find it on Polymarket: open a market, copy the token ID from the URL or API.
# MANDATORY for both dry-run and live mode.
POLY_TOKEN_ID=YOUR_CLOB_TOKEN_ID


# ═══ BOT MODE ════════════════════════════════════════════════════════════════
# true  → paper trading (no real orders, no credentials needed)
# false → live trading (requires POLY_PRIVATE_KEY and POLY_FUNDER_ADDRESS)
BOT_DRY_RUN=true

BOT_SQLITE_PATH=platform.sqlite3   # SQLite database file (relative to project root)
BOT_LOG_JSON=false                  # true → JSON log lines; false → human-readable
BOT_LOG_LEVEL=INFO                  # DEBUG | INFO | WARNING | ERROR
BOT_KILL_SWITCH_PATH=./KILL_SWITCH  # Create this file to emergency-stop the bot


# ═══ LIVE TRADING CREDENTIALS ════════════════════════════════════════════════
# Required only when BOT_DRY_RUN=false.
# NEVER share or commit these values.
POLY_PRIVATE_KEY=0xYOUR_PRIVATE_KEY
POLY_FUNDER_ADDRESS=0xYOUR_FUNDER_ADDRESS
POLY_SIGNATURE_TYPE=0

# Optional: pre-derived L2 API credentials (skips on-start key derivation).
# If blank, credentials are derived automatically from POLY_PRIVATE_KEY.
POLY_API_KEY=
POLY_API_SECRET=
POLY_API_PASSPHRASE=


# ═══ STRATEGY THRESHOLDS ═════════════════════════════════════════════════════
# ThresholdStrategy (default plugin):
#   BUY  when ask  <= BUY_THRESHOLD  (price is below our estimated fair value)
#   SELL when bid  >= SELL_THRESHOLD AND we hold shares
#
# Keep SELL_THRESHOLD > BUY_THRESHOLD to create a dead-band and avoid flip-flopping.
BUY_THRESHOLD=0.45          # Buy when ask price is at or below this (0.0-1.0)
SELL_THRESHOLD=0.55         # Sell when bid price is at or above this (0.0-1.0)
STRAT_BUY_AMOUNT_USD=10.00  # USD per BUY order
STRAT_SELL_SHARES=5.00      # Shares per SELL order
STRAT_ORDER_TYPE=FAK        # FAK (Fill-And-Kill) | FOK (Fill-Or-Kill)


# ═══ PROFITABILITY GATE ══════════════════════════════════════════════════════
# Blocks trades where expected net edge (after fees) is too small.
# net_edge = gross_edge - FEE_TAKER_BPS  must be >= MIN_EXPECTED_EDGE_BPS.
FEE_TAKER_BPS=200           # Polymarket taker fee in basis points (verify per market)
MIN_EXPECTED_EDGE_BPS=50    # Minimum acceptable net edge after fees


# ═══ RISK LIMITS ═════════════════════════════════════════════════════════════
# Risk state is persisted in SQLite and survives restarts.
RISK_MAX_POSITION_SHARES=50           # Maximum shares held at any time
RISK_MAX_USD_SPEND=200                # Cumulative USD cap across all restarts
RISK_MIN_SECONDS_BETWEEN_ORDERS=5     # Minimum cooldown between orders (seconds)
RISK_MAX_OPEN_ORDERS=10               # Maximum concurrent open orders (live mode)


# ═══ CIRCUIT BREAKER ═════════════════════════════════════════════════════════
# Trips to OPEN state on any of these conditions; manual reset required (reset-cb).
CB_MAX_CONSECUTIVE_LOSSES=5        # Trip after N consecutive losing trades
CB_MAX_DAILY_DRAWDOWN_USD=50.0     # Trip if daily loss exceeds this USD amount
CB_MAX_DECISION_LATENCY_MS=500.0   # Trip if decision-to-order latency exceeds this


# ═══ FEED SETTINGS ═══════════════════════════════════════════════════════════
# WebSocket feed is primary; falls back to REST polling after repeated failures.
FEED_FALLBACK_AFTER_FAILURES=5      # WS consecutive failures before REST fallback
FEED_POLL_INTERVAL_SECONDS=2.0      # REST fallback polling interval (seconds)
FEED_MAX_STALENESS_SECONDS=30.0     # Trip CB if no quote received for this long
FEED_WS_MAX_RECONNECT_BACKOFF=60.0  # Maximum WS reconnect backoff (seconds)


# ═══ OPTIONAL: POSITION REFRESH, HEARTBEAT, RETRY ════════════════════════════
BOT_POSITION_REFRESH_INTERVAL_SECONDS=10.0  # How often to refresh position from Data API

# Heartbeat keeps resting (GTC) orders alive. Enable only for GTC strategies.
BOT_HEARTBEAT_ENABLED=false
BOT_HEARTBEAT_INTERVAL_SECONDS=15.0

BOT_MAX_RETRIES=4                # API call retries on transient errors
BOT_REQUEST_TIMEOUT_SECONDS=15.0
